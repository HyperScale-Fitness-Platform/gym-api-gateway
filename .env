PORT=8080
AUTH_SERVICE_URL=http://localhost:4000
OPERATIONS_SERVICE_URL=http://localhost:4001
PEOPLE_SERVICE_URL=http://localhost:4002
SOCIAL_SERVICE_URL=http://localhost:4003
COMMERCE_SERVICE_URL=http://localhost:4005
ORDER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:4004
AI_SERVICE_URL=http://localhost:4006

# S3 — IRSA handles this automatically inside EKS. Locally, outside the
# cluster, the SDK has no IRSA to fall back on, so a scoped IAM user's keys
# are needed here instead (never your root/admin keys).
AWS_REGION=us-east-1
PRODUCT_IMAGES_BUCKET=gym-platform-product-images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ORDER_SERVICE_URL=http://localhost:4007
PROGRESS_SERVICE_URL=http://localhost:3001
